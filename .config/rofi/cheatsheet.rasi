* {
    bg: #11111b;
    bg-alt: #1e1e2e;
    bg-selected: #313244;
    fg: #cdd6f4;
    fg-alt: #a6adc8;
    accent: #cba6f7;
    border-col: #45475a;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 65%;
    background-color: @bg;
    border: 2px;
    border-color: @border-col;
    border-radius: 16px;
    padding: 24px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 12px 16px;
    margin: 0px 0px 16px 0px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 11";
    margin: 0px 10px 0px 0px;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder-color: @fg-alt;
    placeholder: "Gõ để tìm phím tắt (terminal, workspace, screenshot, lock)...";
}

listview {
    background-color: transparent;
    lines: 16;
    columns: 1;
    spacing: 6px;
    cycle: true;
}

element {
    background-color: @bg-alt;
    text-color: @fg;
    padding: 10px 16px;
    border-radius: 10px;
    border: 0px;
}

element selected {
    background-color: @bg-selected;
    text-color: @accent;
    border: 1px;
    border-color: @accent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
