# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #0b0f11
selected_bg = #151a1e
header_bg = #1f272c

# Text colors
text = #dfe6ed
selected_text = #a6cbe6
header_text = #a5acb3
inactive_text = #6f767d

# GPU utilization colors (gradient from low to high)
gpu_util_low = #a7eaff
gpu_util_med = #d0f9f4
gpu_util_high = #8ab5ff

# Memory usage colors
memory_low = #b4e7ff
memory_med = #85d0fc
memory_high = #78c4fb

# Temperature colors (cool to hot)
temp_cool = #a7eaff
temp_warm = #d0f9f4
temp_hot = #8ab5ff

# Power usage colors
power_low = #a7eaff
power_med = #e0c2f9
power_high = #abbef0

# Process list colors
process_normal = #dfe6ed
process_highlight = #a6cbe6
process_killed = #8ab5ff

# Border and separator colors
border = #6f767d
separator = #41494f

# Chart and graph colors
chart_line = #dadeff
chart_fill = #151a1e

# Status indicators
status_ok = #a7eaff
status_warning = #d0f9f4
status_error = #8ab5ff
status_info = #78c4fb
