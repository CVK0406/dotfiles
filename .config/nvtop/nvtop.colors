# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #121412
selected_bg = #1e201e
header_bg = #414942

# Text colors
text = #e2e3de
selected_text = #fbfff8
header_text = #c1c8c0
inactive_text = #8b938b

# GPU utilization colors (gradient from low to high)
gpu_util_low = #a8f0b7
gpu_util_med = #dff8d4
gpu_util_high = #c5b542

# Memory usage colors
memory_low = #aceec7
memory_med = #7ed8b6
memory_high = #62cfb4

# Temperature colors (cool to hot)
temp_cool = #a8f0b7
temp_warm = #dff8d4
temp_hot = #c5b542

# Power usage colors
power_low = #a8f0b7
power_med = #b8d79b
power_high = #c6c177

# Process list colors
process_normal = #e2e3de
process_highlight = #fbfff8
process_killed = #c5b542

# Border and separator colors
border = #8b938b
separator = #414942

# Chart and graph colors
chart_line = #fdfeff
chart_fill = #1e201e

# Status indicators
status_ok = #a8f0b7
status_warning = #dff8d4
status_error = #c5b542
status_info = #62cfb4
