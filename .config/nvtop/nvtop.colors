# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #0e0e0e
selected_bg = #1a1a1a
header_bg = #262626

# Text colors
text = #e5e5e5
selected_text = #c6c6c6
header_text = #ababab
inactive_text = #757575

# GPU utilization colors (gradient from low to high)
gpu_util_low = #c8e5ef
gpu_util_med = #ecf2f0
gpu_util_high = #9db5e2

# Memory usage colors
memory_low = #d0e2ec
memory_med = #a6cce5
memory_high = #99c1e2

# Temperature colors (cool to hot)
temp_cool = #c8e5ef
temp_warm = #ecf2f0
temp_hot = #9db5e2

# Power usage colors
power_low = #c8e5ef
power_med = #d8c8e2
power_high = #b7bed5

# Process list colors
process_normal = #e5e5e5
process_highlight = #c6c6c6
process_killed = #9db5e2

# Border and separator colors
border = #757575
separator = #484848

# Chart and graph colors
chart_line = #e7e5e8
chart_fill = #1a1a1a

# Status indicators
status_ok = #c8e5ef
status_warning = #ecf2f0
status_error = #9db5e2
status_info = #99c1e2
