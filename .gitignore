# ==============================================================================
# Dotfiles .gitignore Configuration
# ==============================================================================

# ---- User Directories & Media ----
Downloads/
Desktop/
Documents/
Videos/
Music/

# ---- Build Artifacts, Package Managers & Caches ----
.cache/
.local/share/
.cargo/
.rustup/
.npm/
.node_repl_history
.pnpm-store/
.fnm/
__pycache__/
*.pyc
.venv/
venv/

# ---- System & App Caches / Logs ----
.config/**/Cache/
.config/**/Cache_Data/
.config/**/CachedData/
.config/**/Code Cache/
.config/**/GPUCache/
.config/**/Dawn*/
.config/**/Crashpad/
.config/**/logs/
.config/**/log/
.config/**/Blob Storage/
.config/**/Shared Storage/
.config/**/Session Storage/
.config/**/Local Storage/
.config/**/Service Worker/
.config/**/WebStorage/
.config/**/Shared Dictionary/
.config/**/Trust Tokens/
.config/**/DIPS/
.config/**/TransportSecurity/
.config/**/Network Persistent State/
.config/**/Cookies*
.config/**/Preferences
.config/**/History*
.config/**/Profiles/
.config/**/CachedProfilesData/
.config/**/store_cache/

# ---- Machine-Specific Profiles & Heavy Apps ----
.config/firefox/
.config/zen/
.config/BraveSoftware/
.config/google-chrome/
.config/discord/
.config/Antigravity IDE/
.config/BetterDiscord/
.config/heroic/tools/
.config/heroic/store/
.config/heroic/store_cache/
.config/libreoffice/

# ---- Credentials, Secrets & Machine State ----
.9router/
.ssh/
.gnupg/
*.pem
*.key
.env
.env.*
.config/gh/hosts.yml
.config/gh/config.yml
.config/pulse/cookie
.config/dconf/
.config/session/
.config/ibus/bus/
.config/fcitx/dbus/
.config/go/telemetry/
.config/git/ignore
.config/micro/buffers/
.config/configstore/
.config/shelly/appimage-metadata-v2.db
.config/.updaterId

# ---- Binary State & Temporary Files ----
**/*.sqlite*
**/*.db
**/*.lz4
**/*.log
**/*.tmp
**/*.swp
**/*.bak
**/datareporting/
**/sentry/
